gn:left;font-size:9px;letter-spacing:1px;color:#9b9087;font-weight:700;padding:11px 10px;border-bottom:1px solid #eee9e3}td{padding:13px 10px;border-bottom:1px solid #f1ede8;font-size:11px;color:#514942}td small{display:block;color:#a1978f;font-size:9px;margin-top:4px}.event-link{border:0;padding:0;background:none;color:#8e3d34;font-size:12px;font-weight:700;text-align:left}.row-actions{display:flex;gap:4px}.icon-button{border:0;background:transparent;color:#8c8178;padding:6px;border-radius:7px;display:inline-grid;place-items:center}.icon-button:hover{background:#f4eee9}.icon-button.danger{color:#b05248}.status{font-size:9px;padding:5px 8px;border-radius:20px;background:#f7efe1;color:#9c702f}.status.good{background:#e9f3eb;color:#4c8658}.status.pending{background:#f8efe2;color:#9c702f}.empty{text-align:center;padding:32px 10px;color:#8d8279}.empty-icon{margin:0 auto 10px;width:38px;height:38px;border-radius:12px;background:#f7eee8;color:#9d5a4b;display:grid;place-items:center}.empty b{font-size:12px;color:#554b43}.empty p,.muted{font-size:11px;color:#9b9189}.performer-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.performer-card{background:#fff;border:1px solid #eee8e1;border-radius:12px;padding:17px;display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center}.performer-card .person-avatar{grid-row:span 1}.performer-info h3{font:700 13px Manrope;margin:0 0 3px}.performer-info small{font-size:10px;color:#978d85}.performer-stats{grid-column:1/-1;border-top:1px solid #f0ece7;padding-top:11px;display:flex;justify-content:space-between;font-size:10px;color:#91867d}.performer-stats b{display:block;color:#3c342f;margin-top:4px}.performer-card details{grid-column:1/-1;font-size:10px;color:#8e4439}.performer-card summary{cursor:pointer}.history-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f2eee9;color:#5b5149}.history-row small{display:block;color:#9a8e84;margin-top:3px}.inline-add{display:flex;gap:9px;align-items:center;margin-bottom:18px}.inline-add>input{border:1px solid #e5ddd5;border-radius:8px;padding:10px;font-size:12px;min-width:130px}.inline-add .searchbox{max-width:240px}.stats-grid+.panel{margin-top:18px}.status-toggle{border:0;background:#f8efe1;color:#966b2e;border-radius:20px;padding:7px 10px;font-size:10px}.status-toggle.is-paid{background:#e8f3ea;color:#4e8559}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field-group{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:600;color:#6e6259}.field-group.span-2{grid-column:span 2}.subsection{margin-top:22px;padding-top:18px;border-top:1px solid #eee8e1}.subsection-head{margin-bottom:13px}.assignment-add{display:grid;grid-template-columns:1.1fr 1.1fr 1fr .8fr auto;gap:8px}.assignment-row{display:flex;align-items:center;gap:16px;padding:11px 0;border-bottom:1px solid #f0ece7;font-size:11px}.assignment-row>div:first-child{flex:1}.assignment-row small{display:block;color:#a0968d;margin-top:3px}.assignment-row label{display:flex;align-items:center;gap:6px;color:#8c8178}.assignment-row label input:not([type=checkbox]){width:95px;border:1px solid #e5ddd5;border-radius:7px;padding:7px}.check-label{white-space:nowrap}.sub-total{display:flex;justify-content:space-between;padding:14px 0;font-size:12px}.modal-backdrop{position:fixed;inset:0;background:#201a18a8;z-index:50;display:grid;place-items:center;padding:20px;overflow:auto}.modal{background:#fff;width:min(600px,100%);max-height:92vh;overflow:auto;border-radius:15px;padding:22px;box-shadow:0 20px 70px #0003}.modal.wide{width:min(850px,100%)}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.modal-head h2{font:800 19px Manrope;margin:0}.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:22px}.detail-hero{display:flex;justify-content:space-between;align-items:flex-start;padding:18px;background:#f8f3ef;border-radius:12px;margin-bottom:16px}.detail-hero h