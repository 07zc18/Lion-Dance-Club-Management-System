@media(max-width:1100px){.sidebar{width:225px}.main{margin-left:225px}.content{padding:28px 24px}.stats-grid{grid-template-columns:repeat(2,1fr)}.performer-grid{grid-template-columns:repeat(2,1fr)}.assignment-add{grid-template-columns:1fr 1fr}.finance-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.sidebar{transform:translateX(-100%);transition:.2s}.sidebar.show{transform:translateX(0)}.main{margin-left:0}.topbar{padding:0 16px}.mobile-toggle{display:grid}.breadcrumb{margin-right:auto;margin-left:10px}.sync-label{font-size:0}.content{padding:24px 15px}.page-heading{align-items:flex-start;flex-direction:column}.page-heading h1{font-size:27px}.stats-grid{grid-template-columns:1fr 1fr;gap:9px}.stat-card{padding:14px}.stat-value{font-size:17px}.two-col{grid-template-columns:1fr}.performer-grid{grid-template-columns:1fr}.toolbar{align-items:stretch}.tabs{order:0}.searchbox{min-width:0}.form-grid{grid-template-columns:1fr}.field-group.span-2{grid-column:auto}.assignment-add{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr 1fr}.finance-grid{grid-template-columns:1fr 1fr}.commission-row{align-items:stretch;flex-direction:column}.commission-row>div:first-child{width:100%}.expense-form{grid-template-columns:1fr}.inline-add{flex-wrap:wrap}.inline-add>*{flex:1}.auth-page{grid-template-columns:1fr}.auth-art{min-height:270px;padding:25px}.auth-copy{margin:35px 0}.auth-copy h1{font-size:38px}.auth-foot{display:none}.auth-panel{padding:30px 22px}.assignment-row{flex-wrap:wrap}.role-rate label{min-width:145px}.add-role-row{flex-wrap:wrap}.modal{padding:17px}.month-field{width:100%}}
