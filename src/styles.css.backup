@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#292522;background:#f7f5f2;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:258px;background:#241d1c;color:#f8f3ee;padding:26px 17px;display:flex;flex-direction:column;z-index:20}.brand{display:flex;align-items:center;gap:12px;padding:0 8px 34px}.brand-icon{width:42px;height:42px;border-radius:13px;background:#9d3932;color:#fff;display:grid;place-items:center}.brand b{display:block;font:800 14px Manrope;max-width:155px}.brand small{display:block;color:#a99d96;font-size:9px;letter-spacing:1.5px;margin-top:4px}.nav-caption,.eyebrow{font-size:10px;letter-spacing:1.7px;font-weight:700;color:#a17b55}.nav-caption{color:#877b74;padding:0 12px 10px}.nav-link{border:0;background:transparent;color:#c9c0ba;padding:12px 13px;border-radius:10px;text-align:left;display:flex;align-items:center;gap:12px;margin:2px 0;font-size:13px}.nav-link:hover,.nav-link.active{background:#3b302e;color:white}.nav-link.active{box-shadow:inset 3px 0 #c58b4f}.nav-count{margin-left:auto;background:#55413b;padding:2px 8px;border-radius:20px;font-size:10px}.sidebar-user{margin-top:auto;border-top:1px solid #4a3e3a;padding:18px 4px 0;display:flex;align-items:center;gap:10px}.avatar,.person-avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#ead8c8;color:#843b32;font-weight:700}.user-meta{min-width:0;flex:1}.user-meta b,.user-meta small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user-meta b{font-size:12px}.user-meta small{font-size:10px;color:#a99d96;margin-top:3px}.main{margin-left:258px;min-height:100vh}.topbar{height:68px;background:#fff;border-bottom:1px solid #eee9e3;display:flex;align-items:center;justify-content:space-between;padding:0 38px;position:sticky;top:0;z-index:10}.breadcrumb{font-size:12px;color:#847