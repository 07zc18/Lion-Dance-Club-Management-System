n-bottom:22px}.section-title{margin:20px 0 10px}.section-title h3{font:700 14px Manrope;margin:0 0 5px}.section-title p{font-size:11px;color:#968b82;margin:0}.role-rate span{flex:1}.role-rate label{display:flex;align-items:center;gap:8px;color:#998e85}.role-rate input{width:120px}.add-role-row{display:flex;gap:8px;margin:16px 0 22px}.add-role-row input{border:1px solid #e5ddd5;border-radius:8px;padding:10px;min-width:0;flex:1;font-size:11px}.account-note{display:flex;gap:12px;background:#f8f3ef;padding:14px;border-radius:10px;margin-top:22px;color:#985347}.account-note b,.account-note small{display:block}.account-note b{font-size:11px;color:#59483e}.account-note small{font-size:10px;color:#93877d;margin-top:4px}.toast{position:fixed;right:25px;bottom:24px;background:#2d2724;color:#fff;padding:12px 17px;border-radius:9px;display:flex;align-items:center;gap:9px;font-size:12px;z-index:100;box-shadow:0 8px 30px #0002}.toast svg{color:#a6d3a9}.auth-page{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;background:#fff}.auth-art{background:radial-gradient(circle at 80% 20%,#88443b 0,#462b28 35%,#251d1b 75%);color:white;padding:42px 9%;display:flex;flex-direction:column}.auth-brand{display:flex;align-items:center;gap:12px;font:800 12px Manrope;letter-spacing:1.5px}.auth-copy{margin:auto 0;max-width:520px}.auth-copy h1{font:800 clamp(40px,5vw,66px)/1.08 Manrope;letter-spacing:-2px;margin:17px 0}.auth-copy h1 em{color:#d7a46d;font-style:normal}.auth-copy p{color:#d2c3ba;max-width:390px;line-height:1.7;font-size:13px}.auth-foot{font-size:10px;color:#a99b92}.auth-panel{display:grid;place-items:center;padding:35px}.auth-card{width:min(390px,100%)}.auth-symbol{width:44px;height:44px;border-radius:13px;background:#f7ece6;color:#99483d;display:grid;place-items:center;margin-bottom:24px}.auth-card h2{font:800 26px Manrope;margin:8px 0}.auth-card>p{font-size:12px;color:#93887f;margin-bottom:24px}.auth-card label{display:flex;flex-direction:column;gap:7px;font-size:11px;col